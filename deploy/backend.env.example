# Copy to backend.env (ignored). Placeholders deliberately fail production checks.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://surmed_app.PROJECT:REPLACE_PASSWORD@HOST:5432/postgres?sslmode=verify-full
JWT_SECRET=REPLACE_WITH_48_RANDOM_BYTES
JWT_EXPIRES_IN=8h
CORS_ORIGINS=https://crm.example.invalid
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_PRIVATE_STORAGE_KEY
SUPABASE_MEDICAL_BUCKET=medical-records
ENABLE_SWAGGER=false
DB_POOL_MAX=10
# No migrator URL, backup encryption key or initial ADMIN password in runtime.

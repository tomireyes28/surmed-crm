# Separate operational machine/session ONLY. Copy to operations.env (ignored).
# Never pass this file to the running backend or frontend.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT:REPLACE_PASSWORD@HOST:5432/postgres?sslmode=verify-full
# Initial ADMIN provisioning uses DATABASE_URL, ADMIN_EMAIL, ADMIN_PASSWORD,
# ADMIN_NAME supplied temporarily from the secret manager; remove after use.

# Backup process (Node 22 + installed backend dependencies + matching pg_dump).
BACKUP_DATABASE_URL=postgresql://postgres.PROJECT:REPLACE_PASSWORD@HOST:5432/postgres?sslmode=verify-full
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_PRIVATE_STORAGE_KEY
BACKUP_SOURCE_PROJECT_REF=PROJECT
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_64_HEXADECIMAL_CHARACTERS
BACKUP_DIRECTORY=/secure/offsite-transfer/surmed
# Set only AFTER stopping all instances, workers, imports and administrative edits:
# BACKUP_MAINTENANCE_CONFIRMED=writes-stopped
# Optional existing tools container on the operational machine, not public:
# PG_TOOLS_CONTAINER=surmed-pg-tools

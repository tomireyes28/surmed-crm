generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Roles estrictos (RBAC)
enum Role {
  ADMIN
  MEDICO
  RECEPCION
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  password       String   
  name           String
  role           Role            @default(RECEPCION)
  isActive       Boolean         @default(true)
  
  medicalRecords MedicalRecord[] 
  stockMovements StockMovement[] 

  appointments   Appointment[]   @relation("DoctorAppointments")
  specialties    Specialty[]     @relation("DoctorSpecialties")

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("users")
}

model Patient {
  id             String          @id @default(uuid())
  documentId     String          @unique 
  firstName      String
  lastName       String
  email          String?         
  phone          String?
  birthDate      DateTime
  address        String?

  isActive       Boolean         @default(true)
  
  medicalRecords MedicalRecord[] 
  invoices       Invoice[]       
  appointments   Appointment[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("patients")
}

model MedicalRecord {
  id              String              @id @default(uuid())
  patientId       String
  patient         Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  doctorId        String
  doctor          User                @relation(fields: [doctorId], references: [id]) 
  
  notes           String              @db.Text 
  attachments     String[] 
  
  // Correcciones/aclaraciones por adenda sin sobrescribir evoluciones firmadas (T12)
  parentRecordId  String?
  parentRecord    MedicalRecord?      @relation("MedicalRecordAddenda", fields: [parentRecordId], references: [id])
  addenda         MedicalRecord[]     @relation("MedicalRecordAddenda")

  attachmentFiles MedicalAttachment[]

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([patientId, createdAt])
  @@index([parentRecordId])
  @@map("medical_records")
}

model MedicalAttachment {
  id              String        @id @default(uuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  patientId       String
  uploadedById    String

  storagePath     String        @unique
  originalName    String
  mimeType        String
  sizeBytes       Int
  sha256          String
  scanStatus      String        @default("CLEAN_MAGIC_VERIFIED")
  isRevoked       Boolean       @default(false)

  createdAt       DateTime      @default(now())

  @@index([patientId, createdAt])
  @@index([medicalRecordId])
  @@map("medical_attachments")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actorRole   String?
  action      String
  resource    String
  resourceId  String?
  patientId   String?
  reason      String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([resource, resourceId, createdAt])
  @@index([patientId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

enum ProductCategory {
  INSUMO_MEDICO
  OFICINA
  ACTIVO_FIJO
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  quantity    Int      @default(0) 
  minStock    Int      @default(5) 
  price       Decimal? @db.Decimal(12, 2)
  
  category    ProductCategory @default(INSUMO_MEDICO)
  isActive    Boolean         @default(true)
  
  movements   StockMovement[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

model StockMovement {
  id             String       @id @default(uuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  userId         String
  user           User         @relation(fields: [userId], references: [id]) 
  
  type           MovementType
  quantity       Int      
  notes          String?
  idempotencyKey String?      @unique
  
  createdAt      DateTime     @default(now())

  @@index([productId, createdAt])
  @@map("stock_movements")
}

enum MovementType {
  IN   
  OUT  
}

model Invoice {
  id             String        @id @default(uuid())
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id])
  
  totalAmount    Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(PENDING)
  
  paidAt         DateTime?
  paidById       String?
  cancelledAt    DateTime?
  cancelledById  String?
  cancelReason   String?
  idempotencyKey String?       @unique

  items          InvoiceItem[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([patientId, createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  description String   
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  
  createdAt   DateTime @default(now())

  @@map("invoice_items")
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

// ==========================================
// MÓDULO DE AGENDA Y TURNOS
// ==========================================

model Specialty {
  id          String        @id @default(uuid())
  name        String        @unique
  description String?
  
  // Relación Muchos-a-Muchos: Un médico tiene varias especialidades y viceversa
  doctors     User[]        @relation("DoctorSpecialties")
  
  appointments Appointment[]

  @@map("specialties")
}

enum AppointmentStatus {
  PENDING           // Pendiente de confirmación
  CONFIRMED         // Confirmado por el paciente
  IN_WAITING_ROOM   // En sala de espera
  ATTENDED          // Ya fue atendido (Acá engancharemos la factura luego)
  CANCELLED         // Cancelado
}

model Appointment {
  id             String            @id @default(uuid())
  
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  doctorId       String
  doctor         User              @relation("DoctorAppointments", fields: [doctorId], references: [id])
  
  specialtyId    String
  specialty      Specialty         @relation(fields: [specialtyId], references: [id])
  
  date           DateTime          // Fecha y hora exacta del turno
  duration       Int               @default(30) // Duración estimada en minutos
  status         AppointmentStatus @default(PENDING)
  notes          String?           @db.Text
  cancelReason   String?
  idempotencyKey String?           @unique
  
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([doctorId, date])
  @@index([patientId, date])
  @@map("appointments")
}
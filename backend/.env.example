# Configuración del servidor Backend (Surmed CRM)
NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL (obligatorio)
DATABASE_URL="postgresql://usuario:password@localhost:5432/surmed_crm?schema=public"

# Autenticación JWT (obligatorio: mínimo 16 caracteres, nunca usar valores por defecto)
JWT_SECRET="reemplazar_por_secreto_aleatorio_de_al_menos_32_caracteres"
JWT_EXPIRES_IN="8h"

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Supabase Storage (requerido para adjuntos clínicos)
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="reemplazar_por_service_role_key_privada_de_servidor"

# Variables exclusivas para comandos operativos CLI (no dejar fijas en el servidor)
# ADMIN_EMAIL="admin@surmed.com.py"
# ADMIN_PASSWORD="clave_inicial_fuerte_unica"
# ADMIN_NAME="Administrador Surmed"
